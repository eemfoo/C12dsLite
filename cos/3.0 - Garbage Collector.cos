**************************************
* Garbage Collector
**************************************
* Classifiers:
*  1 1 6512 - Garbage Collector
*
* Periodically deletes objects when there are too many
*
***************************************
*
* Installer
inst
lock
doif totl 1 1 6512 eq 1
	stop
endi

doif totl 1 1 6512 gt 1
	enum  1 1 6512
		kill targ
	next
endi


setv va00 game "C1_to_DS_Garbage_Limit"
doif va00 eq 0
	setv va00 15
endi

new: simp 1 1 6512 "blnk" 1 0 0
bhvr 0
attr 16
tick 10

scrp 1 1 6512 9
	inst
	lock

	* Seeds
	setv va00 6500
	reps 2
		call 1000 3 va00
		addv va00 1
	repe

	* Fruit
	setv va00 6500
	reps 2
		call 1000 8 va00
		addv va00 1
	repe

	* Foods
	setv va00 6500
	reps 14
		call 1000 11 va00
		addv va00 1
	repe

	* Potions
	setv va00 6500
	reps 5
		call 1000 25 va00
		addv va00 1
	repe

	tick rand 200 600
endm

scrp 1 1 6512 1000
	inst
	lock
	* Make visibility further
	setv va99 1000
	doif va99 lt wndw
		setv va99 wndw
	endi
	mulv va99 va99

	enum 2 _p1_ _p2_
		seta va10 targ
		doif name "C1_to_DS_Garbage_Collect" eq 1
			doif rand 0 10 eq 0
				doif movs eq 0
					setv va30 gmap posl post
					setv va40 0
					enum 2 _p1_ _p2_
						doif targ ne va10 and movs eq 0
							doif gmap posl post eq va30
								doif disq va10 lt va99
									addv va40 1
								endi
							endi
						endi
					next
					doif va40 gt 3
						targ va10
						gsub delete_if_needed
					endi
				endi
			endi
		endi
	next

	* Delete if not near a creature
	subr delete_if_needed
		setv va20 0
		setv va97 0
		seta va11 null
		doif movs ne 0
			setv ov88 0
			retn
		endi

		* If near pointer
		doif va20 eq 0
			setv va97 0
			targ pntr
			gsub check_range
			targ va10
		endi

		* CHECK creature
		doif va20 eq 0
			setv va97 1
			enum 4 0 0
				gsub check_range
			next
			targ va10
		endi

		* Check CRAG
		doif va20 eq 0
			setv va97 1
			enum 0 0 0
				doif fmly gt 4
					doif crea targ eq 1
						gsub check_range
					endi
				endi
			next
			targ va10
		endi

		targ va10
		doif va20 gt 0
			setv ov88 0
			targ va10
			retn
		endi

		addv ov88 1
		doif ov88 gt 3
			kill va10
		endi
	retn

	subr check_range
		doif va20 ne 0
			retn
		endi
		doif gmap posl post ne va30
			retn
		endi
		doif disq va10 lt va99
			setv va20 1
			retn
		endi

		doif va97 eq 0
			retn
		endi

		doif iitt eq va10
			setv va20 1
		endi
	retn
endm


rscr

enum 1 1 6512
	kill targ
next

scrx 1 1 6512 9
scrx 1 1 6512 1000