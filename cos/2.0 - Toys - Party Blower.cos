**CAOS2Pray Join
*# C3-Name "Party Blower (C3)"
*# DS-Name "Party Blower"
*# Agent Description = "C12DS-Lite Party Blower"
*# Agent Animation Gallery = "c1partyblower"
*# Agent Animation File = "c1partyblower.c16"
*# Agent Sprite First Image = 0
*# Agent Animation String = "0"
*# Agent Bioenergy Value = 0
*# Attach "../images/c1partyblower.c16"
*# Attach "../sounds/c1d2.wav"
*# Attach "../sounds/c1p9.wav"
*# Attach "../catalogue/c12dsl.catalogue"

****************************
* C1 PartyBlower
****************************

* Dependencies:
*  c1partyblower.c16
*  c1d2.wav
*  c1p9.wav

* Installers
inst

new: simp 2 21 6508 "c1partyblower" 0 0 200
attr 199
accg 2
bhvr 43
fric 90
aero 10
elas 0
perm 60
puhl 0 0 12
puhl 1 0 12
puhl 2 0 12
puhl 3 0 12
pupt 0 0 12
pupt 1 0 12
pupt 2 0 12
pupt 3 0 12
tick 20

doif game "C12DS_Lite_Installing" = 1 and totl 2 21 6508 <= 1
* 	PartyBlower in ocean tunnel
	mvsf 4090 18508
elif type game "ds_game_type" ne 2
* 	it's NOT a string, this must be C3 only
* 	choose a safe C3 location
	setv va00 5440
	setv va01 3580
	velo rand 30 40 -5
	mvsf va00 va01
else
* 	it IS a string, but what is the value?
	doif game "ds_game_type" eq "undocked"
* 		this is an undocked world, location needs to be DS safe
		setv va00 6100
		setv va01 9200
		velo rand 30 40 -5
		mvsf va00 va01
	elif game "ds_game_type" eq "docked"
* 		this is a docked world, location can be anywhere in the DS/C3 realm
		setv va00 6100
		setv va01 9200
		velo rand 30 40 -5
		mvsf va00 va01
	endi
endi

****************************
* Scripts

scrp 2 21 6508 1
    inst
    lock
    stim writ from 97 1
    targ from
    doif targ ne null
        doif crea targ = 1
            doif dirn = 0 or dirn = 1
                dirn rand 2 3
            endi
            urge writ targ 21 2.0 6 2.0
        endi
    endi
    targ ownr
    sndc "c1p9"
    anim [0 1 2 3 2 1 0]
    over
    inst
    targ from
    doif targ ne null
        doif crea targ = 1
            urge writ targ -1 2.0 -1 2.0
        endi
    endi
endm

scrp 2 21 6508 3
*	PartyBlower is hit
	inst
	lock
	stim writ from 97 1
	velo rand -10 10 rand -10 -20
	sndc "c1d2"
	setv ov00 0
endm

scrp 2 21 6508 4
*	PartyBlower is picked up
endm

scrp 2 21 6508 5
*	PartyBlower is dropped
endm

scrp 2 21 6508 6
*	PartyBlower collides
	inst
	lock
	doif ov00 = 0
		doif vely < 10 or vely > 10
			stpc
			sndc "c1d2"
		elif vely > -2 and vely < 2
			stpc
		endi
	endi
	pose 0
endm

scrp 2 21 6508 9
    inst
    seta va00 carr
    doif va00 ne null
        targ va00
        doif crea targ = 1
            setv va22 dirn
            targ ownr
            doif va22 = 2
                mira 0
            elif va22 = 3
                mira 1
            endi
        endi
    endi
endm

scrp 2 21 6508 2
    inst
    lock
    stim writ from 97 1
    targ from
    doif targ ne null
        doif crea targ = 1
            doif dirn = 0 or dirn = 1
                dirn rand 2 3
            endi
            urge writ targ 21 2.0 6 2.0
        endi
    endi
    targ ownr
    sndc "c1p9"
    anim [0 1 2 3 2 1 0]
    over
    inst
    targ from
    doif targ ne null
        doif crea targ = 1
            urge writ targ -1 2.0 -1 2.0
        endi
    endi
endm

rscr
inst
doif game "C12DS_Lite_Loaded" eq 1
    setv va00 game "c12dsl::metaroom::id"
else
    setv va00 -1
endi

enum 2 21 6508
    doif gmap posl post ne va00
        kill targ
    endi
next

doif game "C12DS_Lite_Loaded" eq 0
    scrx 2 21 6508 1
    scrx 2 21 6508 3
    scrx 2 21 6508 4
    scrx 2 21 6508 5
    scrx 2 21 6508 6
    scrx 2 21 6508 9
    scrx 2 21 6508 2
endi
