******************************
* C1 Ugly Tomatoes
*******************************
* Classifiers:
*  2 5 6502 - Nightshade Plant
*  2 9 6503 - Nightshade Fruit
* Dependencies:
*  c1plants.c16
*  chwp.wav
******************************

**CAOS2Pray Join
*# C3-Name "Ugly Tomatoes (C3)"
*# DS-Name "Ugly Tomatoes"
*# Agent Description = "Ugly tomatoes reduce sex drive and increase aging"
*# Agent Animation File = "c1plants.c16"
*# Agent Animation Gallery = "c1plants"
*# Agent Sprite First Image = 12
*# Agent Animation String = "1"
*# bioenergy = 0
*# Attach "../images/c1plants.c16"
*# Attach "../catalogue/c12dsl.catalogue"
*# Depend "chwp.wav"
******************************
inst
lock

new: vhcl 2 5 6504 "c1plants" 1 12 100
setv name "C1_to_DS_Lite_Clickable_Food" 1
attr 715
doif game "C1_to_DS_Lite_Clickable_Food" eq 1
	setv va88 attr
	orrv va88 4
	attr va88
endi

cabn -6 7 28 30
accg 5
fric 100
aero 10
elas 0
bhvr 0
perm 60
tick rand 900 1000
mesg wrt+ targ 1000 0 0 0

doif game "C1_to_DS_Lite_Installing" = 1 or totl 2 5 6504 <= 1 or 1 eq 1
* 	Ugly Tomato plant
	mvsf 5130 18867
elif type game "ds_game_type" ne 2
* 		it's NOT a string, this must be C3 only
* 		choose a safe C3 location
	setv va00 5440
	setv va01 3580
	velo rand 30 40 -5
	mvsf va00 va01
else
* 		it IS a string, but what is the value?
	doif game "ds_game_type" eq "undocked"
* 			this is an undocked world, location needs to be DS safe
		setv va00 6100
		setv va01 9200
		velo rand 30 40 -5
		mvsf va00 va01
	elif game "ds_game_type" eq "docked"
* 			this is a docked world, location can be anywhere in the DS/C3 realm
		setv va00 6100
		setv va01 9200
		velo rand 30 40 -5
		mvsf va00 va01
	endi
endi

*************
* Scripts

scrp 2 5 6504 1
*	Ugly Tomato plant clicked
	inst
	doif game "C1_to_DS_Lite_Clickable_Food" = 1
		setv va00 posl
		setv va01 post
		new: simp 2 9 6505 "c1plants" 1 13 101
		addv va00 -1
		addv va01 15
		seta va20 targ
		elas 0
		bhvr 48
		perm 60
		accg 5
		fric 100
		aero 10
		attr 199
		mvsf va00 va01
		velo rand -10 10 rand 1 5
	endi
endm

scrp 2 5 6504 9
*	Ugly Tomato plant timer
	inst
	mesg wrt+ ownr 1000 0 0 0
endm

scrp 2 5 6504 125
*	Ugly Tomato plant lost ugly tomato
	inst
	mesg wrt+ ownr 1000 0 0 rand 20 110
endm

scrp 2 5 6504 1000
*	Ugly Tomato plant's timer
	inst
	setv va20 0
	epas 2 9 6505
		addv va20 1
	next

	doif va20 < 1 or _p1_ = 1
*		no flower exists, so better make one
		setv va00 posl
		setv va01 post
		new: simp 2 9 6505 "c1plants" 1 13 101
		setv name "C1_to_DS_Lite_Clickable_Food" 1
		addv va00 -1
		addv va01 15
		seta va20 targ
		mvsf va00 va01
		accg 0
		attr 195
		doif game "C1_to_DS_Lite_Clickable_Food" eq 1
			setv va88 attr
			orrv va88 4
			attr va88
		endi
		fric 100
		elas 0
		aero 100
		bhvr 48
		perm 60
		targ ownr
		doif _p1_ <> 1
			setv va52 0
			loop
				spas ownr va20
				wait 1
				inst
				addv va52 1
				targ va20
			untl targ = null or carr = ownr or va52 > 10
			inst
		else
			targ va20
			velo rand -10 10 rand 1 5
		endi
		accg 5
		fric 100
		aero 10
	endi
endm

scrp 2 9 6505 1
*	Ugly Tomato clicked
	inst
	doif game "C1_to_DS_Lite_Clickable_Food" = 1
		setv va00 posl
		setv va01 post
		new: simp 2 9 6505 "c1plants" 1 13 101
		setv name "C1_to_DS_Garbage_Collect" 1
		addv va00 -1
		addv va01 15
		seta va20 targ
		elas 0
		bhvr 48
		perm 60
		accg 5
		fric 100
		aero 10
		attr 199
		mvsf va00 va01
		velo rand -10 10 rand -15 -5
	endi
endm

scrp 2 9 6505 4
*	I've been picked up
*	Ugly Tomato
	inst
	lock
	setv name "C1_to_DS_Garbage_Collect" 1
	mira rand 0 1
	attr 195
	doif game "C1_to_DS_Lite_Clickable_Food" eq 1
		setv va88 attr
		orrv va88 4
		attr va88
	endi
	accg 3
	fric 90
	aero 10
endm

scrp 2 9 6505 12
*	eating a weed
*	Ugly Tomato
	inst
	lock
	seta va20 norn
	targ from
	doif crea targ = 1
		chem 5 0.9
		chem 161 -1.0
		chem 116 0.1
		snde "chwp"
		stim writ from 83 1
	endi
	targ ownr
	kill targ
endm

rscr

doif game "C1_to_DS_Lite_Loaded" eq 1
	setv va00 game "c12dsl::metaroom::id"
else
	* If C12DSL is not installed, make metaroom ID negative and impossible to match
	setv va00 -1
endi

*enum 2 5 6504
*	doif gmap posl post ne va00
*		kill targ
*	endi
*next
*
*enum 2 9 6505
*	doif gmap posl post ne va00
*		kill targ
*	endi
*next

enum 2 5 6504
	kill targ
next

enum 2 9 6505
	kill targ
next

doif game "C1_to_DS_Lite_Loaded" eq 0
	scrx 2 5 6504 1
	scrx 2 5 6504 9
	scrx 2 5 6504 125
	scrx 2 5 6504 1000

	scrx 2 9 6505 1
	scrx 2 9 6505 4
	scrx 2 9 6505 12
endi