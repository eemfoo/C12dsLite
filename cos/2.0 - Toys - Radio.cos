****************************
* C1 Radio
****************************
* Classifier:
*  2 21 6514 - Radio
*
* Dependencies:
*  c1radio.c16
*  c1r4.wav
*  c1d2.wav
*  c1r6.wav
*  c1r7.wav
* ***************************
**CAOS2Pray Join
*# C3-Name "Radio (C3)"
*# DS-Name "Radio"
*# Agent Animation File = "c1radio.c16"
*# Agent Animation Gallery = "c1radio"
*# Agent Sprite First Image = 0
*# Agent Animation String = "0"
*# Agent Bioenergy Value = 0
*# Agent Description = "The radio provides musical entertainment for creatures"
*# Attach "../images/c1radio.c16"
*# Attach "../sounds/c1d2.wav"
*# Attach "../sounds/c1r4.wav"
*# Attach "../sounds/c1r6.wav"
*# Attach "../sounds/c1r7.wav"
*# Attach "../catalogue/c12dsl.catalogue"

**************************
* Installers
inst

new: simp 2 21 6514 "c1radio" 0 0 200
attr 199
accg 5
bhvr 43
fric 12.5
aero 10
elas 0
perm 60
frat 1.5

doif game "C1_to_DS_Lite_Installing" = 1 and totl 2 21 6514 <= 1
* 	Radio in music room
	mvsf 2247 19050
elif type game "ds_game_type" ne 2
* 	it's NOT a string, this must be C3 only
* 	choose a safe C3 location
	setv va00 5440
	setv va01 3580
	velo rand 30 40 -5
	mvsf va00 va01
else
* 	it IS a string, but what is the value?
	doif game "ds_game_type" eq "undocked"
* 		this is an undocked world, location needs to be DS safe
		setv va00 6100
		setv va01 9200
		velo rand 30 40 -5
		mvsf va00 va01
	elif game "ds_game_type" eq "docked"
* 		this is a docked world, location can be anywhere in the DS/C3 realm
		setv va00 6100
		setv va01 9200
		velo rand 30 40 -5
		mvsf va00 va01
	endi

endi

****************************
* Scripts


scrp 2 21 6514 1
*	Radio is pushed
	inst
	lock
	stim writ from 97 1
	stpc
	setv va00 rand 0 2
	doif va00 = 0
		sndc "c1r4"
		anim [0 1 2 3 2 1 2 3 2 1 0 1 2 3 3 2 1 0 1 2 3 2 1 2 3 2 1 0 1 2 3 3 2 1]
		over
		wait 30
	elif va00 = 1
		anim [3 2 1]
		over
		sndc "c1r6"
		wait 40
	elif va00 = 2
		anim [2 3 2 1 0]
		over
		sndc "c1r7"
		wait 40
	endi
endm


scrp 2 21 6514 2
*	Radio is pushed
	inst
	lock
	stim writ from 97 1
	stpc
	setv va00 rand 0 2
	doif va00 = 0
		sndc "c1r4"
		anim [0 1 2 3 2 1 2 3 2 1 0 1 2 3 3 2 1 0 1 2 3 2 1 2 3 2 1 0 1 2 3 3 2 1]
		over
		wait 30
	elif va00 = 1
		anim [3 2 1]
		over
		sndc "c1r6"
		wait 40
	elif va00 = 2
		anim [2 3 2 1 0]
		over
		sndc "c1r7"
		wait 40
	endi
endm

scrp 2 21 6514 3
*	Radio is hit
	inst
	lock
	stim writ from 97 1
	velo rand -10 10 rand -10 -20
	sndc "c1d2"
	setv ov00 0
endm

scrp 2 21 6514 4
*	Radio is picked up	
endm

scrp 2 21 6514 5
*	Radio is dropped
endm

scrp 2 21 6514 6
*	Radio collides
	inst
	lock
	doif ov00 = 0
		doif vely < 10 or vely > 10
			stpc
			sndc "c1d2"
		elif vely > -2 and vely < 2
			stpc
		endi
	endi
endm

****************************
* Removers

* Radio remover
rscr

doif game "C1_to_DS_Lite_Loaded" eq 1
	setv va00 game "c12dsl::metaroom::id"
else
	* If C12DSL is not installed, make metaroom ID negative and impossible to match
	setv va00 -1
endi

enum 2 21 6514
	doif gmap posl post ne va00
		kill targ
	endi
next