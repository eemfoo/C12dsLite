********************************
* C1 Spinning Top Toy
********************************
* Classifier:
*   2 21 6501 - Top
* Files:
*   c1top.c16
*   c1to.wav
********************************
**CAOS2Pray Join
*# DS-Name "C1L Top"
*# Agent Animation File = "c1top.c16"
*# Agent Animation Gallery = "c1top"
*# Agent Sprite First Image = 0
*# Agent Animation String = "0"
*# Agent Bioenergy Value = 0
*# Agent Description = "This toy makes noise and provides a fun diversion for creatures"
*# Attach "../images/c1top.c16"
*# Attach "../sounds/c1to.wav"
*# Attach "../catalogue/c12dsl.catalogue"
********************************

* Top
new: simp 2 21 6501 "c1top" 0 0 5000
attr 199
bhvr 43
accg 5
elas 0
fric 90
aero 10
perm 70
*	tick 1
pose 0
setv ov99 0
setv ov98 180
addv ov91 5

doif game "C1_to_DS_Lite_Loaded" eq 1 and totl 2 21 6504 <= 1
    mvsf 2131 18878
elif type game "ds_game_type" ne 2
* 	it's NOT a string, this must be C3 only
* 	choose a safe C3 location
    setv va00 5440
    setv va01 3580
    velo rand 30 40 -5
    mvsf va00 va01
else
* 	it IS a string, but what is the value?
    doif game "ds_game_type" eq "undocked"
* 		this is an undocked world, location needs to be DS safe
        setv va00 6100
        setv va01 9200
        velo rand 30 40 -5
        mvsf va00 va01
    elif game "ds_game_type" eq "docked"
* 		this is a docked world, location can be anywhere in the DS/C3 realm
        setv va00 6100
        setv va01 9200
        velo rand 30 40 -5
        mvsf va00 va01
    endi
endi

setv ov90 posl
setv ov91 post


scrp 2 21 6501 1
*   top is pushed
    call 1000 from 0
endm

scrp 2 21 6501 2
*	top is pulled
    call 1000 from 0
endm

scrp 2 21 6501 3
*	top is hit
    call 1000 from 0
endm

scrp 2 21 6501 1000
*   Top is activated
    stim writ _p1_ 97 1
    doif ov99 = 0
        tick 1
        setv ov97 0
        setv ov99 1
        sndc "c1to"
    endi
endm

scrp 2 21 6501 4
*	top picked up
    setv ov99 0
    stpc
    pose 0
endm

scrp 2 21 6501 6
*	top collides
    setv ov99 0
    stpc
    pose 0
endm


scrp 2 21 6501 9
*	top timer
    inst
    doif ov99 = 0
        tick 0
        stpc
        pose 0
        doif movs = 0
            mvsf posl post
        endi
    else
        doif ov97 = 0
            anim [0 1 2 3 4 5 6 7 255]
            setv ov90 posl
            setv ov91 post
            addv ov91 5
            addv ov97 1
        elif ov97 > 0 and ov97 < 120
            setv va00 ov90
            setv va10 sin_ ov98
            mulv va10 40
            addv va00 va10
            addv ov98 7.5
            doif ov98 >= 360
                setv ov98 0
            endi
            setv va11 va10
            absv va11
            doif va10 < 0 and obst left >= va11
                setv va00 ov90
                setv va01 post
                addv va01 5
                addv va00 va10
            elif va10 > 0 and obst rght >= va11
                setv va00 ov90
                setv va01 post
                addv va01 5
                addv va00 va10
            else
                setv va00 posl
                setv va01 post
                addv va01 5
            endi
            doif movs = 0 and carr = null
                mvsf va00 va01
            endi
            addv ov97 1
        else
            setv ov99 0
        endi
    endi
endm


rscr
* top remover
setv va88 game "c12dsl::metaroom::id"

enum 2 21 6501
    doif gmap posl post ne va88
        kill targ
    endi
next

doif totl 2 21 6501 eq 0
    scrx 2 21 6501 1
    scrx 2 21 6501 2
    scrx 2 21 6501 3
    scrx 2 21 6501 4
    scrx 2 21 6501 6
    scrx 2 21 6501 9
    scrx 2 21 6501 1000
endi