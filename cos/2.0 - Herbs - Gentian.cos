******************************
* C1 Gentian
******************************
* Classifiers:
*  2 4 6505 - Gentian Plant
*  2 25 6504 - Gentian Flower
*
* Dependencies:
*  C1Plants.c16
******************************
**CAOS2Pray Join
*# C3-Name "Gentian (C3)"
*# DS-Name "Gentian"
*# Agent Description = "Gentian reduces feeling extremes of temperature. Useful to alleviate symptoms of fever."
*# bioenergy = 0
*# Agent Animation File = "c1plants.c16"
*# Agent Animation Gallery = "c1plants"
*# Agent Sprite First Image = 0
*# Agent Animation String = "0"
*# Attach "../images/c1plants.c16"
*# Attach "../catalogue/c12dsl.catalogue"
******************************

inst
lock

new: vhcl 2 4 6505 "c1plants" 1 28 7001
setv name "C1_to_DS_Lite_Clickable_Food" 1
cabn 28 10 66 48
attr 731
doif game "C1_to_DS_Lite_Clickable_Food" eq 1
	setv va88 attr
	orrv va88 4
	attr va88
endi
accg 5
fric 100
aero 10
elas 0
bhvr 11
perm 60
tick rand 900 1000
mesg wrt+ targ 1000 0 0 10

doif game "C1_to_DS_Lite_Installing" = 1 and totl 2 4 6505 <= 1
	mvsf 3673 18882
	setv va88 attr
	setv va89 va88
	andv va89 1
	doif va89 ne 0
		subv va88 1
	endi
	setv va89 va88
	andv va89 2
	doif va89 ne 0
		subv va88 2
	endi
	attr va88
elif type game "ds_game_type" ne 2
* 		it's NOT a string, this must be C3 only
* 		choose a safe C3 location
	setv va00 5440
	setv va01 3580
	velo rand 30 40 -5
	mvsf va00 va01
else
* 		it IS a string, but what is the value?
	doif game "ds_game_type" eq "undocked"
* 			this is an undocked world, location needs to be DS safe
		setv va00 6100
		setv va01 9200
		velo rand 30 40 -5
		mvsf va00 va01
	elif game "ds_game_type" eq "docked"
* 			this is a docked world, location can be anywhere in the DS/C3 realm
		setv va00 6100
		setv va01 9200
		velo rand 30 40 -5
		mvsf va00 va01
	endi
endi

***********
* Scripts

scrp 2 4 6505 1
*	Gentian Plant clicked
	inst
	doif from eq pntr and game "C1_to_DS_Lite_Clickable_Food" = 1
		mesg wrt+ ownr 1000 1 0 0
	else
		stim writ from 87 1
	endi
endm

scrp 2 4 6505 2
*	Gentian Plant pulled
	inst
	stim writ from 87 1
endm

scrp 2 4 6505 3
*	Gentian Plant hit
	inst
	stim writ from 87 1
endm

scrp 1 1 6507 9
*	Gentian plant timer
	inst
	doif movs = 0
		mesg wrt+ targ 1000 0 0 0
	endi
endm

scrp 2 4 6505 125
	inst
	doif movs = 0
		mesg wrt+ targ 1000 0 0 rand 20 90
	endi
endm

scrp 2 4 6505 1000
*	Gentian plant's timer
	inst
	setv va20 0
	epas 2 25 6504
		addv va20 1
	next

	doif va20 < 1 or _p1_ = 1
*		no flower exists, so better make one
		setv va00 posl
		setv va01 post
		new: simp 2 25 6504 "c1plants" 2 29 7001
		setv name "C1_to_DS_Lite_Clickable_Food" 1
		puhl 0 18 18
		puhl 1 18 18
		addv va00 30
		addv va01 28
		mvsf va00 va01
		seta va20 targ
		accg 0
		fric 100
		elas 0
		aero 100
		bhvr 48
		perm 60
		attr 195
		doif game "C1_to_DS_Lite_Clickable_Food" eq 1
			setv va88 attr
			orrv va88 4
			attr va88
		endi
		targ ownr
		doif _p1_ <> 1
			setv va52 0
			loop
				spas ownr va20
				wait 1
				inst
				addv va52 1
				targ va20
			untl targ = null or carr = ownr or va52 > 10
			inst
		else
			targ va20
			pose 1
			velo rand -10 10 rand 1 5
		endi
		accg 3
		fric 100
		aero 10
	endi
endm

scrp 2 25 6504 1
*	Gentian clicked
	inst
	doif from eq pntr and game "C1_to_DS_Lite_Clickable_Food" = 1
		setv va00 posl
		setv va01 post
		new: simp 2 25 6504 "c1plants" 2 29 7001
		setv name "C1_to_DS_Lite_Clickable_Food" 1
		puhl 0 18 18
		puhl 1 18 18
		elas 0
		bhvr 48
		perm 60
		attr 199
		accg 3
		fric 100
		aero 10
		pose 1
		mvsf va00 va01
		velo rand -10 10 rand 1 5
	endi
endm


scrp 2 25 6504 4
*	Gentian - I've been picked up
	inst
	lock
	pose 1
endm

scrp 2 25 6504 12
*	eating a flower
*	Gentian
	inst
	lock
	seta va20 norn
	targ from
	doif crea targ = 1
		chem 5 0.9
		chem 152 -1.0
		chem 153 -1.0
*		chem 33 1.0
*		chem 72 -1.0
*		chem 94 1.0
		snde "chwp"
		stim writ from 78 1
	endi
	targ ownr
	kill targ
endm

rscr

doif game "C1_to_DS_Lite_Loaded" eq 1
	setv va00 game "c12dsl::metaroom::id"
else
	* If C12DSL is not installed, make metaroom ID negative and impossible to match
	setv va00 -1
endi

enum 2 4 6505
	doif gmap posl post ne va00
		kill targ
	endi
next

enum 2 25 6504
	doif gmap posl post ne va00
		kill targ
	endi
next