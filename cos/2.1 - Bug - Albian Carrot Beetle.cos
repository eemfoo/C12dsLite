* 2 13 6500 - Albian Carrot Beetle
* Dependencies: c1carrotbeetle.c16, c1bg.wav, c1b5.wav
* Farming: 1 1 6504 carrot manager; food: 2 11 6500/6510 and C3/DS carrots.
* Albian Carrot Beetle

* ov99: -1/1 walking direction, 0 idle, 2 carried, 3 startled
* ov98 - hunger
* Fixed bug: carrot beetle stopped farming in Albia if all carrots were consumed.

* Install

inst
new: simp 2 13 6500 "c1carrotbeetle" 18 0 600
attr 199
bhvr 59
accg 2
elas 0
aero 10
perm 60
tick rand 2 3
rnge 1999
fric 20
pupt -1 10 12
setv ov98 10

doif game "C12DS_Lite_Loaded" = 1 and totl 2 13 6500 <= 1
*	C1 to DS
    * Source position 4580 10892, offset by x: -2000, y: +8000.
    mvto 2580 18892
elif type game "ds_game_type" ne 2
* 	it's NOT a string, this must be C3 only
* 	choose a safe C3 location
    setv va00 5440
    setv va01 3580
    velo rand 30 40 -5
    mvsf va00 va01
else
* 	it IS a string, but what is the value?
    doif game "ds_game_type" eq "undocked"
* 		this is an undocked world, location needs to be DS safe
        setv va00 6100
        setv va01 9200
        velo rand 30 40 -5
        mvsf va00 va01
    elif game "ds_game_type" eq "docked"
* 		this is a docked world, location can be anywhere in the DS/C3 realm
        setv va00 6100
        setv va01 9200
        velo rand 30 40 -5
        mvsf va00 va01
    endi
endi

scrp 2 13 6500 1
*    Play with carrot beetle (carrot beetle doesn't like that!)
    inst
    setv ov99 3
    stim writ from 85 1.0
    sndc "c1bg"
    doif rand 0 1 = 0
        mira 1
        anim [6 16 15 14 13 12 11 10 255]
        velo 15 -15
    else
        mira 0
        anim [6 16 15 14 13 12 11 10 255]
        velo -15 -15
    endi
endm

scrp 2 13 6500 2
*    Play with carrot beetle (carrot beetle doesn't like that!)
    inst
    setv ov99 3
    stim writ from 85 1.0
    sndc "c1bg"
    doif rand 0 1 = 0
        mira 1
        anim [6 16 15 14 13 12 11 10 255]
        velo 15 -15
    else
        mira 0
        anim [6 16 15 14 13 12 11 10 255]
        velo -15 -15
    endi
endm

scrp 2 13 6500 3
*    hit carrot beetle
    inst
    setv ov99 3
    stim writ from 87 1.0
    slow
    sndc "c1b5"
*    look squished for a second    
    anim [9 9 9 9 9 9 9 9 9 6]
    over
    inst
    stpc
    sndc "c1bg"
    doif rand 0 1 = 0
        mira 1
        anim [6 16 15 14 13 12 11 10 255]
        velo 15 -15
    else
        mira 0
        anim [6 16 15 14 13 12 11 10 255]
        velo -15 -15
    endi
endm

scrp 2 13 6500 4
*    pickup carrot beetle
    inst
    setv ov99 2
    stpc
    sndc "c1bg"
    anim [6 10 6 16 6 7 255]
endm

scrp 2 13 6500 5
*    dropped carrot beetle
    inst
    doif rand 0 1 = 0
        mira 1
        anim [6 16 15 14 13 12 11 10 255]
        setv ov99 1
    else
        mira 0
        anim [6 16 15 14 13 12 11 10 255]
        setv ov99 -1
    endi
endm

scrp 2 13 6500 6
*    carrot beetle collides
    inst
    doif velx = 0 and vely = 0
        pose 6
    endi
    stpc
*    Resume after landing if carried or startled; preserve walking direction.
    doif wall = down and ov99 > 1
        setv ov99 rand 0 1
        doif ov99 = 0
            setv ov99 -1
        endi
    endi
    doif wall = left
        setv ov99 1
    elif wall = rght
        setv ov99 -1
    endi
    tick rand 2 3
endm

scrp 2 13 6500 9
*    carrot beetle timer
    inst
*     move - and let's make sure you are near a carrot
    doif movs = 4
        anim [6 10 6 16 6 7 255]
        setv ov99 2
    elif movs = 0 and pose >= 10 and obst down < 5
        pose 6
        velo 0 -2
    elif ov99 <= 1 and obst down < 5
        setv va20 10000000
        seta va21 null
* Ask the existing carrot manager periodically, including when supply is zero.
        doif ov98 le 0
            rtar 1 1 6504
            doif targ ne null
                mesg writ targ 1000
            endi
            targ ownr
            setv ov98 100
        else
            subv ov98 1
        endi
        targ ownr
        seta va21 null
        esee 2 11 1
            doif targ ne null
                doif va21 eq null or rand 0 2 ge 1
                    setv va16 bhvr
                    andv va16 16
                    doif va16 ne 0 and carr eq null and sqrt disq ownr < va20 and seee ownr targ = 1
                        seta va21 targ
                        setv va00 posl
                        setv va02 posr
                        setv va20 sqrt disq ownr
                    endi
                endi
            endi
        next
        esee 2 11 9
            doif targ ne null
                doif va21 eq null or rand 0 2 ge 1
                    setv va16 bhvr
                    andv va16 16
                    doif va16 ne 0 and carr eq null and sqrt disq ownr < va20 and seee ownr targ = 1
                        seta va21 targ
                        setv va00 posl
                        setv va02 posr
                        setv va20 sqrt disq ownr
                    endi
                endi
            endi
        next
        esee 2 11 6500
            doif targ ne null
                doif va21 eq null or rand 0 2 ge 1
                    setv va16 bhvr
                    andv va16 16
                    doif va16 ne 0 and carr eq null and sqrt disq ownr < va20 and seee ownr targ = 1
                        seta va21 targ
                        setv va00 posl
                        setv va02 posr
                        setv va20 sqrt disq ownr
                    endi
                endi
            endi
        next
        esee 2 11 6510
            doif targ ne null
                doif va21 eq null or rand 0 2 ge 1
                    setv va16 bhvr
                    andv va16 16
                    doif va16 ne 0 and carr eq null and sqrt disq ownr < va20 and seee ownr targ = 1
                        seta va21 targ
                        setv va00 posl
                        setv va02 posr
                        setv va20 sqrt disq ownr
                    endi
                endi
            endi
        next
        targ ownr
        doif va21 ne null and va20 >= 100 and va20 < 2000 and movs = 0
            doif posl > va02
                setv ov99 -1
            endi
            doif posr < va00
                setv ov99 1
            endi
        else
*            choose a direction    
            inst
            setv va22 rand 1 20
            doif va22 >= 20
                doif mira = 0
                    setv ov99 1
                else
                    setv ov99 -1
                endi
            elif va22 <= 1
                setv ov99 0
            endi
        endi
*     see if you are touching a known carrot type
        ttar 2 11 6500
        doif targ = null
            ttar 2 11 6510
            doif targ = null
                ttar 2 11 9
                doif targ = null
                    ttar 2 11 1
                endi
            endi
        endi

        inst
        seta va15 targ
        targ ownr
        doif va15 <> null and movs = 0
*        yes, you are touching a viable carrot and you are moving about freely
            targ va15
            setv va16 bhvr
            andv va16 16
            doif va16 ne 0 and carr eq null and rand 0 mv98 = 0
                lock
*                Harvest the carrot using its existing pickup script.
                mesg writ va15 4
                targ ownr
                inst
                velo 0 0
                fric 100
                pose 6
                wait rand 7 11
                inst
                targ va15
                doif targ <> null
                    setv va50 posx
                    setv va51 posy
                    addv va50 rand -10 10
                    mesg writ targ 12
                endi
            endi
        endi

        inst
*        turn if needed
        targ ownr
        doif velx < 0 and ov99 = 1
            fric 100
            anim [7 7 7 8 8 8]
            over
            inst
            velo 0 0
            mira 1
            anim [7 7 7 6 6 6]
            over
            inst
        elif velx > 0 and ov99 = -1
            fric 100
            anim [7 7 7 8 8 8]
            over
            inst
            velo 0 0
            mira 0
            anim [7 7 7 6 6 6]
            over
            inst
        endi

        inst
*        go forward or stop
        doif ov99 = 1 or ov99 = -1
            setv va60 rand 3 7
            mulv va60 ov99
            doif ov99 = 1
                mira 1
            else
                mira 0
            endi
            anim [0 1 2 3 4 5 6 255]
            fric 0
            velo va60 -1
            wait rand 7 11
            inst
        elif ov99 = 0
            fric 100
            velo 0 0
            anim [7 7 7 8]
            over
            inst
            wait rand 22 33
            inst
            tick rand 2 3
            doif rand 0 1 = 1
                setv ov99 1
            else
                setv ov99 -1
            endi
        endi

*        hill holder
        inst
        targ ownr
        doif velx < 0 and ov99 = 1
            fric 100
            velo 0 0
        elif velx > 0 and ov99 = -1
            fric 100
            velo 0 0
        endi
        doif ov99 = -1
            mira 0
        elif ov99 = 1
            mira 1
        endi
    endi
endm

scrp 2 13 6500 12
*    carrot beetle is eaten
    inst
    stim writ from 80 1.0
    anim [9 9 9 9 9 9 9 9 9 6]
    over
    inst
    stpc
    sndc "c1bg"
    doif rand 0 1 = 0
        mira 1
        anim [6 16 15 14 13 12 11 10 255]
        velo 15 -15
    else
        mira 0
        anim [6 16 15 14 13 12 11 10 255]
        velo -15 -15
    endi
endm

rscr
enum 2 13 6500
    kill targ
next

doif game "C12DS_Lite_Loaded" eq 0
    scrx 2 13 6500 1
    scrx 2 13 6500 2
    scrx 2 13 6500 3
    scrx 2 13 6500 4
    scrx 2 13 6500 5
    scrx 2 13 6500 6
    scrx 2 13 6500 9
    scrx 2 13 6500 12
    scrx 2 13 6500 1001
endi

