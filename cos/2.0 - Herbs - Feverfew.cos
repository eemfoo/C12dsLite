******************************
* C1 Feverfew
******************************
*
* Classifiers:
*   2 4 6504 - Feverfew Plant
*   2 25 6501 - Feverfew Flower
*
* Dependencies:
*  c1plants.c16
******************************
**CAOS2Pray Join
*# C3-Name "Feverfew (C3)"
*# DS-Name "Feverfew"
*# Agent Description = "Feverfew provides pain relief properties and good source of energy"
*# Agent Animation File = "c1plants.c16"
*# Agent Animation Gallery = "c1plants"
*# Agent Sprite First Image = 17
*# Agent Animation String = "2"
*# bioenergy = 0
*# Attach "../images/c1plants.c16"
*# Attach "../catalogue/c12dsl.catalogue"
******************************

* Installation
inst
lock

new: vhcl 2 4 6504 "c1plants" 1 17 200
attr 731
setv name "C12DS_Lite_Clickable_Food" 1
doif game "C12DS_Lite_Clickable_Food" eq 1
    setv va88 attr
    orrv va88 4
    attr va88
endi
cabn 10 -3 40 30
accg 5
fric 100
aero 10
elas 0
bhvr 11
perm 60
tick rand 400 1000
mesg wrt+ targ 1001 0 0 10


doif game "C12DS_Lite_Installing" = 1 and totl 2 4 6504 <= 1
*and totl 2 4 6504 < 1
* 	Feverfew plant
    mvsf 3374 18863
    setv va88 attr
    setv va89 va88
    andv va89 1
    doif va89 ne 0
        subv va88 1
    endi
    setv va89 va88
    andv va89 2
    doif va89 ne 0
        subv va88 2
    endi
    attr va88

* 	hide the Feverfew pot
    new: simp 1 1 6506 "c1plants" 1 38 0
    attr 0
    accg 0
    fric 100
    aero 10
    elas 0
    bhvr 0
    mvto 3373 18883

elif type game "ds_game_type" ne 2
* 	it's NOT a string, this must be C3 only
* 	choose a safe C3 location
    setv va00 5440
    setv va01 3580
    velo rand 30 40 -5
    mvsf va00 va01
else
* 	it IS a string, but what is the value?
    doif game "ds_game_type" eq "undocked"
* 		this is an undocked world, location needs to be DS safe
        setv va00 6100
        setv va01 9200
        velo rand 30 40 -5
        mvsf va00 va01
    elif game "ds_game_type" eq "docked"
* 		this is a docked world, location can be anywhere in the DS/C3 realm
        setv va00 6100
        setv va01 9200
        velo rand 30 40 -5
        mvsf va00 va01
    endi
endi


***********
* Scripts

scrp 2 4 6504 1
*	Feverfew plant clicked
    inst
    doif from eq pntr and game "C12DS_Lite_Clickable_Food" = 1
        mesg wrt+ ownr 1001  1 0 0
    else
        stim writ from 84 1
    endi
endm

scrp 2 4 6504 2
*	Feverfew plant clicked
    inst
    stim writ from 84 1
endm

scrp 2 4 6504 3
*	Feverfew plant clicked
    inst
    stim writ from 84 1
endm

scrp 2 25 6501 1
*	Feverfew weed clicked
    inst
    lock
    doif from eq pntr and game "C12DS_Lite_Clickable_Food" = 1
        setv va00 posl
        setv va01 post
        new: simp 2 25 6501 "c1plants" 2 18 101
        setv name "C12DS_Garbage_Collect" 1
        setv name "C12DS_Lite_Clickable_Food" 1
        seta va20 targ
        fric 100
        aero 10
        elas 0
        bhvr 48
        perm 60
        pose 1
        accg 3
        attr 199
        aero 10
        mvsf va00 va01
        velo rand -15 15 rand -15 -5
    endi
endm

scrp 2 4 6504 9
*	Feverfew plant timer
    inst
    doif movs = 0
        mesg wrt+ targ 1001 0 0 0
    endi
endm


scrp 2 4 6504 125
*	Feverfew weed lost flower
    inst
    mesg wrt+ ownr 1001 0 0 rand 10 100
endm


scrp 2 4 6504 1001
*	Feverfew plant's stuff
    inst
    doif movs = 0
        setv va20 0
        epas 2 25 6501
            addv va20 1
        next
        doif va20 < 1 or _p1_ <> 0
*		no flower exists, so better make one
            setv va00 posl
            setv va01 post
            new: simp 2 25 6501 "c1plants" 2 18 101
            setv name "C12DS_Lite_Clickable_Food" 1
            attr 195
            doif game "C12DS_Lite_Clickable_Food" eq 1
                setv va88 attr
                orrv va88 4
                attr va88
            endi
            addv va00 10
            addv va01 10
            seta va20 targ
            fric 100
            aero 10
            elas 0
            bhvr 48
            perm 60
            mvsf va00 va01
            targ ownr
            doif _p1_ <> 1
*			growing
                targ va20
                setv va21 0
                loop
                    targ ownr
                    spas ownr va20
                    wait 1
                    inst
                    targ va20
                    addv va21 1
                untl carr = ownr or va21 > 100
                targ va20
            else
*			vending		
                targ va20
                pose 1
                velo rand -10 10 rand 1 5
            endi
            targ va20
            accg 3
            fric 90
            aero 10
        endi
    else
        mesg wrt+ ownr 1001 0 0 rand 10 40
    endi
endm

scrp 2 25 6501 4
*	Feverfew picked up
    pose 1
    setv name "C12DS_Garbage_Collect" 1
endm

scrp 2 25 6501 12
*	eating a weed
*	Feverfew
    inst
    lock
    seta va20 norn
    targ from
    doif crea targ = 1
        chem 148 -1.0
        chem 149 -1.0
        chem 150 -1.0
        chem 151 -1.0
        chem 5 0.9
*		chem 34 1.0
*		chem 90 -1.0
*		chem 99 0.5
*		chem 100 0.5
        snde "chwp"
        stim writ from 84 1
    endi
    targ ownr
    kill targ
endm

rscr

doif game "C12DS_Lite_Loaded" eq 1
    setv va00 game "c12dsl::metaroom::id"
else
    * If C12DSL is not installed, make metaroom ID negative and impossible to match
    setv va00 -1
endi

enum 2 4 6504
    doif gmap posl post ne va00
        kill targ
    endi
next


enum 2 25 6501
    doif gmap posl post ne va00
        kill targ
    endi
next

doif game "C12DS_Lite_Loaded" eq 0
    scrx 2 4 6504 1
    scrx 2 4 6504 2
    scrx 2 4 6504 3
    scrx 2 4 6504 9
    scrx 2 4 6504 125
    scrx 2 4 6504 1001

    scrx 2 25 6501 1
    scrx 2 25 6501 4
    scrx 2 25 6501 12
endi