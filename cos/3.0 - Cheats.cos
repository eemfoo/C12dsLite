* 1 1 6509 - Cheat Controller

new: simp 1 1 6509 "blnk" 1 0 0
attr 16
bhvr 0

* ========================== *
* ===== Clickable Food ===== *
* ========================== *

* Toggle Clickable Food
scrp 1 1 6509 1000
	inst
	setv va00 1001
	addv va00 game "C1_to_DS_Lite_Clickable_Food"
	call va00 0 0
endm

* Set clickable food to true
scrp 1 1 6509 1001
	inst

	* Do not run if already set
	doif game "C1_to_DS_Lite_Clickable_Food" eq 1
		stop
	endi

	setv game "C1_to_DS_Lite_Clickable_Food" 1

	enum 2 0 0
		doif name "C1_to_DS_Lite_Clickable_Food" eq 1
			gsub make_clickable
		endi
	next

	subr make_clickable
		setv va00 attr
		orrv va00 4
		attr va00
	retn
endm

* Set clickable food to true
scrp 1 1 6509 1002
	inst

	* Do not run if already set
	doif game "C1_to_DS_Lite_Clickable_Food" eq 0
		stop
	endi

	setv game "C1_to_DS_Lite_Clickable_Food" 0

	enum 2 0 0
		doif name "C1_to_DS_Lite_Clickable_Food" eq 1
			gsub remove_clickable
		endi
	next

	subr remove_clickable
		setv va00 attr
		andv va00 4
		doif va00 ne 0
			setv va00 attr
			subv va00 4
			attr va00
		endi
	retn

endm

* Toggle Stackable lemons
scrp 1 1 6509 1010
	inst
	setv va00 1011
	addv va00 game "C1_to_DS_Lite_Stackable_Lemons"
	call va00 0 0
endm

* Enable Stackable lemons
scrp 1 1 6509 1011

	* Do not run if already set
	doif game "C1_to_DS_Lite_Stackable_Lemons" eq 1
		stop
	endi

	setv game "C1_to_DS_Lite_Stackable_Lemons" 1
	enum 2 8 6500
		cabw 0
	next
endm

* Disable Stackable Lemons
scrp 1 1 6509 1012

	* Do not run if already set
	doif game "C1_to_DS_Lite_Stackable_Lemons" eq 0
		stop
	endi

	setv game "C1_to_DS_Lite_Stackable_Lemons" 0

	enum 2 8 6500
		cabw 1
		dpas 0 0 0
	next
endm

rscr
enum 1 1 6509
	kill targ
next

* Clickable Food
scrx 1 1 6509 1000
scrx 1 1 6509 1001
scrx 1 1 6509 1001

* Stackable Lemons
scrx 1 1 6509 1010
scrx 1 1 6509 1011
scrx 1 1 6509 1012