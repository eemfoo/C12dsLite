******************************
* C1 Morning Glory
******************************
*
* Classifiers:
*   2 4 6507 - Morning Glory Plant
*   2 25 6502 - Morning Glory Flower
* Dependencies:
*   c1plants.c16
*   chwp.wav
******************************
**CAOS2Pray Join
*# C3-Name "Morning Glory (C3)"
*# DS-Name "Morning Glory"
*# Agent Description = "Herb reduces tiredness and makes a Norn alert"
*# Agent Animation File = "c1plants.c16"
*# Agent Animation Gallery = "c1plants"
*# Agent Sprite First Image = 0
*# Agent Animation String = "0"
*# bioenergy = 0
*# Attach "../images/c1plants.c16"
*# Attach "../catalogue/c12dsl.catalogue"
*# Depend "chwp.wav"
******************************

* Install
inst
lock

new: vhcl 2 4 6507 "c1plants" 1 20 100
attr 719
cabn 8 1 46 39
accg 25
fric 100
aero 10
elas 0
bhvr 11
perm 60
tick rand 900 1000
mesg wrt+ targ 1000 0 0 10

doif game "C1_to_DS_Lite_Installing" = 1 and totl 2 4 6507 <= 1
    mvsf 4382 18879

elif type game "ds_game_type" ne 2
* 		it's NOT a string, this must be C3 only
* 		choose a safe C3 location
    setv va00 5440
    setv va01 3580
    velo rand 30 40 -5
    mvsf va00 va01
else
* 		it IS a string, but what is the value?
    doif game "ds_game_type" eq "undocked"
* 			this is an undocked world, location needs to be DS safe
        setv va00 6100
        setv va01 9200
        velo rand 30 40 -5
        mvsf va00 va01
    elif game "ds_game_type" eq "docked"
* 			this is a docked world, location can be anywhere in the DS/C3 realm
        setv va00 6100
        setv va01 9200
        velo rand 30 40 -5
        mvsf va00 va01
    endi
endi

*************
* Scripts

scrp 2 4 6507 1
*	Morning Glory clicked
    inst
    doif from eq pntr and game "C1_to_DS_Lite_Clickable_Food" = 1
        mesg wrt+ ownr 1000 1 0 0
    else
        stim writ from 84 1
    endi
endm

scrp 2 4 6507 2
    stim writ from 84 1
endm

scrp 2 4 6507 3
    stim writ from 84 1
endm

scrp 2 4 6507 9
*	Morning Glory timer
    inst
    mesg wrt+ ownr 1000 0 0 0
endm

scrp 2 4 6507 125
*	Morning Glory lost fruit
    inst
    mesg wrt+ ownr 1000 0 0 rand 20 100
endm


scrp 2 4 6507 1000
*	Morning Glory plant's worker
    inst
    setv va20 0
    epas 2 25 6502
        addv va20 1
    next

    doif va20 < 1 or _p1_ = 1
*		no flower exists, so better make one
        setv va00 posl
        setv va01 post
        new: simp 2 25 6502 "c1plants" 2 21 101
        mira 1
        addv va00 9
        addv va01 9
        mvsf va00 va01
        seta va20 targ
        accg 0
        attr 199
        fric 100
        elas 0
        aero 10
        bhvr 48
        perm 60
        targ ownr
        doif _p1_ <> 1
            setv va52 0
            loop
                spas ownr va20
                wait 1
                inst
                addv va52 1
                targ va20
            untl targ = null or carr = ownr or va52 > 10
            inst
        else
            targ va20
            pose 1
            velo rand -10 10 rand 1 5
        endi
        attr 199
        accg 5
    endi
endm

scrp 2 25 6502 1
*	Morning Glory clicked
    inst
    doif game "C1_to_DS_Lite_Clickable_Food" = 1
        setv va00 posl
        setv va01 post
        new: simp 2 25 6502 "c1plants" 2 21 101
        mira 1
        addv va00 9
        addv va01 9
        seta va20 targ
        accg 5
        attr 199
        fric 100
        elas 0
        aero 10
        bhvr 48
        perm 60
        pose 1
        mira rand 0 1
        mvsf va00 va01
        velo rand -10 10 rand -10 -5
    endi
endm

scrp 2 25 6502 4
*	Morning Glory - I've been picked up
    inst
    lock
    pose 1
    mira rand 0 1
endm

scrp 2 25 6502 12
*	eating a flower
*	Morning Glory
    inst
    lock
    targ from
    chem 5 0.9
    chem 154 -1.0
    chem 155 -1.0
    snde "chwp"
    kill ownr
endm

rscr


doif game "C1_to_DS_Lite_Loaded" eq 1
    setv va00 game "c12dsl::metaroom::id"
else
    * If C12DSL is not installed, make metaroom ID negative and impossible to match
    setv va00 -1
endi

enum 2 4 6507
    doif gmap posl post ne va00
        kill targ
    endi
next

enum 2 25 6502
    doif gmap posl post ne va00
        kill targ
    endi
next