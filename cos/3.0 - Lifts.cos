* C12DS-Lite lifts and call buttons (Docking Station).
* Adapted from C12DS Lifts.cos and https://creatures.wiki/New_lift_script.
* Dependencies: c1lift.c16, c1bu.wav, c1lf.wav; buzz.wav ships with DS.
* Lift: ov00 moving, ov01 level (bottom = 0).
* Button: ov00 pending call, ov01 level, ov16 associated lift.
* Button ov10/11/12 preserve the previous CA link for removal.
* The C1 cabin floor is 150 pixels below its origin, 14 above sprite POSB.
* Unlike the tutorial's sprite, its separate up/down parts are 2 and 3.

inst
doif game "C12DS_Lite_Installing" = 1
* An interrupted installation can leave a few lifts and buttons behind.
* Rebuild that incomplete set instead of treating any existing lift as success.
doif totl 3 1 6500 <> 5 or totl 2 12 6500 <> 14
* Restore the scent links before deleting their call buttons.
enum 2 12 6500
    doif targ <> null
        doif ov10 <> -1 and ov11 <> -1
            doif ov10 <> ov11
                link ov10 ov11 ov12
            endi
        endi
        kill targ
    endi
next
enum 3 1 6500
    doif targ <> null
        seta va16 targ
        doif ov18 <> null
            targ ov18
            zomb 0
            targ va16
        endi
* Install/removal has no OWNR: EPAS cannot enumerate the selected lift.
        enum 4 0 0
            doif targ <> null
                doif carr = va16
                    zomb 0
                endi
            endi
        next
        targ va16
        dpas 4 0 0
        kill targ
    endi
next

*lift next to carrot favorite place
    new: vhcl 3 1 6500 "c1lift" 0 1 90
    cabn -10 -10 114 150
    cabp 1
    cabw 0
    rnge 400
    pat: dull 1 "c1lift" 0 0 0 2
    pat: butt 2 "c1lift" 2 4 82 72 3 [0] 1 1
    pat: butt 3 "c1lift" 3 4 82 83 3 [0] 2 1
    attr 512
    bhvr 3
    accg 0
    aero 100
    fric 100
    elas 0
    perm 0
    mvto 1467 18775.9
    setv ov00 0
    seta ov18 null
    setv ov01 0
    seta va16 targ
    setv va10 -1
* floor 1 call button
    new: simp 2 12 6500 "c1lift" 2 6 90
    attr 196
    accg 25
    aero 10
    fric 90
    elas 0
    perm 60
    bhvr 11
    setv ov00 0
    setv ov01 0
    seta ov16 va16
    mvsf 1567 18844
    setv ov10 grap posx posy
    setv ov11 va10
    setv ov12 0
    doif ov10 <> -1 and ov11 <> -1
        doif ov10 <> ov11
            setv ov12 link ov10 ov11
            link ov10 ov11 100
        endi
    endi
    setv va10 ov10
