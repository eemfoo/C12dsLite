* Cloud Butterfly
*   1 13 6501 - Butterfly Manager
*	2 13 6501 - Cloud Butterfly
*   2 10 6500 - Butterfly Detritus
*
*	ov00 = 0 is caterpillar
*	ov00 = 1 is feeding
*	ov00 = 2 is cocoon
*	ov00 = 3 is butterfly normal
*	ov00 = 4 is butterfly mating
*	ov00 = 5 is butterfly die
*	ov00 = 6 is butterfly egg
*	ov01 = left/right
*	ov02 = up/down
*	ov10 = left boundary
*	ov11 = top boundary
*	ov20 = right boundary
*	ov21 = bottom boundary
*	ov22 = butterfly speed
*	ov50 = life timer
*   ov51 = force cocoon timer
*	ov95 = height
*   ov97 = move target
*	ov98 = target food
*	ov99 = food meter

inst

enum 1 13 6501
	kill targ
next

new: simp 1 13 6501 "blnk" 1 0 0

file jdel 1 "Caterpillars.txt"

reps rand 5 7
	new: simp 2 13 6501 "c1cloudbutterfly" 20 0 525
	mesg writ targ 1003
repe

scrp 1 13 6501 9
	lock
	inst
	doif totl 2 13 6501 > 7
		tick rand 100 300
		stop
	endi
	setv va00 rand 1 2
	slow
	reps va00
		new: simp 2 13 6501 "c1cloudbutterfly" 20 0 525
		mesg writ targ 1003
		tick 4
		wait rand 10 40
	repe

	targ ownr
	doif totl 2 13 6501 lt 7
		tick rand 40 200
	else
		tick rand 600 800
	endi
endm


scrp 1 13 6501 10
	inst
	attr 16
	bhvr 0
	call 9 0 0
endm

scrp 2 10 6500 9
*	Butterfly husk timer
	inst
	lock
	targ ownr
	kill targ
endm

scrp 2 13 6501 1
	inst
	stim writ from 85 1
endm

scrp 2 13 6501 2
	inst
	stim writ from 85 1
endm

scrp 2 13 6501 3
	inst
	stim writ from 25 1
endm

scrp 2 13 6501 6
	inst
*	butterfly collides
	doif pose >= 17 and pose <= 18 and mv00 <> 5
		doif obst down < 10
			accg .5
			elas 0
			fric 100
			frat 5.0
			wait rand 30 50
			pose 17
			wait rand 30 50
			anim [18 17 255]
			frat rand 1.5 1.8
			accg 0
			fric 0
			elas 20
			setv va01 mv22
			mulv va01 rand -2.0 -1.0
			velo 0 va01
			setv mv02 -1
		elif obst _up_ < 10
			setv va01 mv22
			mulv va01 rand 1.0 2.0
			velo 0 va01
			reps rand 1 3
				anim [18 17]
				over
			repe
		elif obst left < 10
			setv mv01 1
			reps rand 1 3
				anim [18 17]
				over
			repe
		elif obst rght < 10
			setv mv01 -1
			reps rand 1 3
				anim [18 17]
				over
			repe
		endi
	elif pose = 19
*		do nothing
	else
*		anim [0 1 2 3 4 5]
		accg .5
	endi
endm


scrp 2 13 6501 9
*	butterfly/caterpillar timer
	inst
	doif totl 1 13 6501 eq 0
		new: simp 1 13 6501 "blnk" 1 0 0
	endi
	slow

	setv mv01 rand -1 1
	doif velx < 0.0 or mv01 = -1
		mira 0
	elif velx > 0.0 or mv01 = 1
		mira 1
	endi

*	check your state
	doif mv00 = 0
		inst
		addv mv51 1
*		just a caterpillar wandering around looking for nothing
*		let's see if you can eat something
		etch 2 11 0
			seta mv98 targ
		next
		doif mv98 <> null
*			you can eat
			setv mv00 1
		else
			targ ownr
			doif rand 0 8 eq 0
				setv mv01 rand -1 1
			endi
			setv va80 gmap posl post
			gsub set_direction
			doif mv98 eq null
				gsub set_direction
			endi
		endi
		doif mv97 eq null and mv98 eq null
			doif mv51 gt 150
				setv mv00 2
			endi
		endi
		slow
	elif mv00 = 1
*		you found food
		doif mv99 > 1
*			you have eaten enough to make a cocoon
			setv mv00 2
		elif mv98 <> null and mv95 < 2
			lock
			targ ownr
			accg 0
			reps rand 1 3
				anim [7 8 9 10 11 12 7]
				over
				mvby 0 -2
				wait rand 30 40
			repe
			accg 2
			addv mv95 1
			unlk
		elif mv98 <> null and mv95 >= 2
			targ mv98
			doif targ <> null
				setv mv00 1
				doif targ <> null
*					mesg writ targ 12
				endi
				addv mv99 1
				setv mv95 0
				seta mv98 null
				targ ownr
				sndc "chwp"
				velo 0 1
				pose 0
				setv mv00 0
				accg 2
			endi
		elif mv98 = null
			setv mv00 0
		endi
	elif mv00 = 2
*		let's make a cocoon
		targ ownr
		doif pose < 13
			velo 0 1
			pose 13
			tick rand 120 200
		elif pose = 13
			pose 14
		elif pose = 14
			setv mv00 3
			doif mv69 = 0
				inst
				mesg writ ownr 1002
				setv mv69 1
				slow
			endi
		endi
	elif mv00 = 3
*		let's emerge as a butterfly!
		targ ownr
		doif pose = 14
			tick 0
			frat 3.0
			pose 15
			wait rand 40 60
			anim [18 17 255]
			wait rand 40 60
			accg 0
			elas 20
			tick rand 140 200
		elif pose >= 17
			inst
			tick 4
			setv mv00 4
			frat rand 1.5 1.8
			velo rand -2.0 2.0 rand -5.0 -3.0
			doif rand 0 1 = 1
				setv mv01 -1
			else
				setv mv01 1
			endi
			targ ownr
		endi
	elif mv00 = 4
*		let's mate, baby, yeah!
		targ ownr
		doif totl 2 13 6501 < 13
			setv va00 posl
			setv va01 post
			esee 2 13 6501
				inst
				lock
				doif targ <> null
					doif ov00 = 4 and mv00 = 4 and disq ownr <= 100
						mesg writ ownr 1001
					endi
				endi
				unlk
				slow
			next
		endi
		addv mv50 1
		doif mv50 = 300
*			you've lived a long time
			mesg writ ownr 1001
		elif mv50 >= 350
			setv mv00 5
		endi
	elif mv00 = 5
*		everything must die in time... and your time is right now. Sorry!
		targ ownr
		pose 18
		accg 3
		fric 90
		elas 0
		wait rand 120 200
		targ ownr
		kill targ
	elif mv00 = 6
		wait rand 120 200
		inst
		setv mv00 0
		setv mv50 0
		pose 0
	endi

	targ ownr
*	check if you are motile
	doif mv00 <> 2 and mv00 <> 5
*		now check if you are out of bounds
		doif mv01 = -1 and posl < mv10
			setv mv01 1
			mira 1
		elif mv01 = 1 and posr > mv20
			setv mv01 -1
			mira 0
		endi
		doif mv00 = 3 or mv00 = 4
			doif post < ov11
				setv ov02 1
			elif posb > ov21
				setv ov02 -1
			endi
		endi
*		set your movement style
		doif mv00 = 0 or mv00 = 1
			fric 75
			aero 0
			elas 0
			accg 2
			doif obst down < 10
				anim [0 1 2 3]
			else
				pose 0
			endi
		elif mv00 = 3 or mv00 = 4
			fric 0
			aero 5
			elas 20
			accg 0
			doif obst down >= 10
				reps rand 1 3
					anim [18 17]
					over
					velo velx -2
				repe
			else
				frat 1.0
				anim [18 17 255]
			endi
		endi

*		move
		doif movs = 0
			inst
			targ ownr
			inst
			doif mv00 = 0 or mv00 = 1
				doif obst down < 10
					setv va00 mv01
					mulv va00 ov22
					mulv va00 2
					setv va01 mv02
					mulv va01 mv22
					setv va10 posl
					addv va10 va00
					setv va11 post
					addv va11 va01
					addv va11 8
					slow
					anim [ 4 5 0 ]
					doif movs = 0
						mvsf va10 va11
*						velo 0 1
					endi
				endi
			elif mv00 = 3 or mv00 = 4
				doif obst down >= 10
					doif accg <> 0
						accg 0
						frat 2.0
					endi
					doif posl < mv10
						setv mv01 1
					elif posr > mv20
						setv mv01 -1
					elif post < mv11
						setv mv02 1
					elif posb > mv21
						setv mv02 -1
					else
						doif rand 1 100 = 100
							mulv mv01 -1
						endi
						doif rand 1 100 = 100
							mulv mv02 -1
						endi
					endi
					setv va00 ov01
					mulv va00 ov22
					setv va01 ov02
					mulv va01 ov22
					velo va00 va01
					doif ov01 = -1
						mira 0
					else
						mira 1
					endi
					reps rand 1 4
						anim [18 17]
						over
						velo va00 va01
					repe
				elif obst down < 10
					targ ownr
					tick 4
					setv ov02 -1
					setv va00 ov01
					mulv va00 ov22
					setv va01 ov02
					mulv va01 ov22
					velo va00 va01
					doif ov01 = -1
						mira 0
					else
						mira 1
					endi
					reps rand 1 4
						anim [18 17]
						over
						velo va00 va01
					repe
				else
					accg .5
					frat 1.0
					anim [18 17 255]
				endi
			endi
			doif ov01 = -1
				mira 0
			else
				mira 1
			endi
		endi
	endi
	subr set_direction
		doif rand 0 1 eq 1
			setv mv01 -1
		else
			setv mv01 1
		endi
		doif type mv97 lt 3
			seta mv97 null
		endi
		doif mv97 <> null or rand 0 5 eq 0
			setv va90 2000
			seta mv97 null
			etch 2 11 0
				inst
				doif mv97 eq null
					seta mv97 targ
				endi
				slow
			next
			setv va92 posy
			doif mv97 eq null
				esee 2 11 6500
					inst
					gsub set_food
					slow
				next
			endi
			doif mv97 eq null
				esee 2 11 0
					inst
					gsub set_food
					slow
				next
			endi
			doif mv97 eq null
				esee 2 3 0
					inst
					gsub set_food
					slow
				next
			endi
			targ ownr
		endi
	retn

	subr set_food
		doif gmap posl post eq va80
			setv va88 relx ownr targ
			setv va89 va88
			absv va89
			doif va89 lt va90
				setv va93 rely ownr targ
				absv va93
				doif va93 < 8
					setv va90 va89
					seta mv97 targ
					doif va88 lt 0
						setv mv01 -1
					else
						setv mv01 1
					endi
				endi
			endi
		endi
		targ ownr
	retn
endm

scrp 2 13 6501 10
	inst
	lock
	seta mv98 null
	seta mv97 null
	attr 199
	bhvr 59
	accg 2
	aero 25
	fric 75
	elas 20
	perm 40
	frat 1.5
	pose 19
	rnge 500
	setv mv00 6
	setv mv01 0
	setv mv02 0
	setv mv10 2080
	setv mv20 3230
	setv mv11 18650
	setv mv21 18920
	setv mv22 rand 2 3
	setv mv95 0
	tick 4
	unlk
endm

scrp 2 13 6501 12
*	butterfly/caterpillar is eaten
	sndc "chwp"
	stim writ from 80 1
	targ ownr
	kill targ
endm


scrp 2 13 6501 1000
	inst
* 	caterpillar inventory
	enum 2 13 6501
		doif ov00 = 0
			addv va00 1
		elif ov00 = 1
			addv va01 1
		elif ov00 = 2
			addv va02 1
		elif ov00 = 3
			addv va03 1
		elif ov00 = 4
			addv va04 1
		elif ov00 = 5
			addv va05 1
		endi
	next
	outs "caterpillars:\t"
	outv va00
	outs "\n"
	outs "eating cats:\t"
	outv va01
	outs "\n"
	outs "cocoons:\t\t"
	outv va02
	outs "\n"
	outs "butterflies:\t"
	outv va03
	outs "\n"
endm

scrp 2 13 6501 1001
*	caterpillar spawn
	inst
	doif totl 2 13 6501 < 4
		setv va00 rand 1 2
	else
		setv va00 1
	endi

	reps va00
		setv va00 posl
		setv va01 post
		new: simp 2 13 6501 "c1cloudbutterfly" 20 0 525
		doif tmvt va00 va01 eq 1
			mvsf va00 va01
		else
			mesg writ targ 1003
		endi
	repe
endm

scrp 2 13 6501 1002
*	leave a husk
	inst
	lock
	setv va00 posl
	setv va01 post
	addv va01 5
	setv va02 plne
	subv va02 1
	new: simp 2 10 6500 "c1cloudbutterfly" 20 0 va02
	pose 16
	attr 199
	accg .5
	elas 0
	perm 60
	fric 100
	aero 10
	bhvr 0
	tick rand 380 480
	mvsf va00 va01
	unlk
endm


scrp 2 13 6501 1003
	inst
	setv va00 rand ov10 ov20
	setv va01 rand ov11 ov21
	mvsf va00 va01
endm

rscr
inst

enum 1 13 6501
	kill targ
next

enum 2 10 6500
	kill targ
next

enum 2 13 6501
	kill targ
next

scrx 1 13 6501 9
scrx 1 13 6501 10

